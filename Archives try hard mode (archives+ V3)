--==================================================
-- SPAWN SAFETY
--==================================================

local function isSafeToSpawn()
    local door = LatestRoom.Value

    if door == 50 or door == 100 then
        return false
    end

    local success, inChase = pcall(function()
        local MainGame = require(
            localPlayer.PlayerGui.MainUI.Initiator.Main_Game
        )

        return MainGame.chase or MainGame.isSeekChase or false
    end)

    if success and inChase then
        return false
    end

    return true
end

local function canSpawn(name)
    local door = LatestRoom.Value

    if door < MIN_DOOR or door > MAX_DOOR then
        return false
    end

    if entityActive then
        return false
    end

    if not isSafeToSpawn() then
        return false
    end

    if door - lastSpawnedRooms[name] < COOLDOWN_DOORS then
        return false
    end

    if os.clock() - lastEntitySpawn < MIN_ENTITY_GAP then
        return false
    end

    return true
end

