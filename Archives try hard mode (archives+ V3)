--==================================================
-- WEIGHTED ENTITY SELECTION
--==================================================

-- Original minimum/maximum intervals determine relative rarity.
-- Shorter original intervals mean higher selection weight.

local function chooseEntity()
    local available = {}
    local totalWeight = 0
    local door = LatestRoom.Value

    for _, entity in ipairs(Entities) do
        if canSpawn(entity.Name) then
            local averageTime = (entity.Min + entity.Max) / 2
            local weight = 1 / averageTime

            totalWeight += weight

            table.insert(available, {
                Data = entity,
                Weight = weight
            })
        end
    end

    if #available == 0 then
        return nil
    end

    local roll = math.random() * totalWeight
    local currentWeight = 0

    for _, entry in ipairs(available) do
        currentWeight += entry.Weight

        if roll <= currentWeight then
            return entry.Data
        end
    end

    return available[#available].Data
end

