-- DOOR-BASED SPAWNING
--==================================================

LatestRoom:GetPropertyChangedSignal("Value"):Connect(function()
    local door = LatestRoom.Value

    if door < MIN_DOOR or door > MAX_DOOR then
        return
    end

    if entityActive or not isSafeToSpawn() then
        return
    end

    if os.clock() - lastEntitySpawn < MIN_ENTITY_GAP then
        return
    end

    local selectedEntity = chooseEntity()

    if selectedEntity then
        runEntity(
            selectedEntity.Name,
            selectedEntity.URL,
            selectedEntity.Warning
        )
    end
end)

