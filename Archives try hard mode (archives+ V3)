local whitelist = {}
local devs = {}

local function isWhitelisted(username)
    for _, name in ipairs(whitelist) do
        if name == username then
            return true
        end
    end

    return false
end

local function isDev(username)
    for _, name in ipairs(devs) do
        if name == username then
            return true
        end
    end

    return false
end

TextChatService.OnIncomingMessage = function(msg)
    local properties = Instance.new("TextChatMessageProperties")

    if msg.TextSource then
        local username = msg.TextSource.Name

        if isWhitelisted(username) then
            properties.PrefixText =
                "<font color='#0000FF'>[Credit]</font> " .. msg.PrefixText

        elseif isDev(username) then
            properties.PrefixText =
                "<font color='#00FF00'>[Dev]</font> " .. msg.PrefixText

        else
            properties.PrefixText =
                "<font color='#FF0000'>[Player]</font> " .. msg.PrefixText
        end
    end

    return properties
end

