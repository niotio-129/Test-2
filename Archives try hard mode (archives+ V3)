--==================================================
-- EXTERNAL ENTITY LOADER
--==================================================

local function runEntity(name, url, warningCallback)
    if not canSpawn(name) then
        return
    end

    entityActive = true
    lastSpawnedRooms[name] = LatestRoom.Value
    lastEntitySpawn = os.clock()

    print("[Archives Tryhard Mode] " .. name .. " spawning.")

    if warningCallback then
        task.spawn(warningCallback)
    end

    local success, err = pcall(function()
        local source = game:HttpGet(url)
        local loadedScript = loadstring(source)

        assert(loadedScript, "Failed to compile " .. name)

        loadedScript()
    end)

    if not success then
        warn("[Archives Tryhard Mode] " .. name .. " failed: " .. tostring(err))
        entityActive = false
        return
    end

    print("[Archives Tryhard Mode] " .. name .. " was triggered.")

    -- External entity scripts do not share a common despawn callback.
    -- Release the scheduler lock after the minimum global gap.
    task.delay(MIN_ENTITY_GAP, function()
        entityActive = false
    end)
end

