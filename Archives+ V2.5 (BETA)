--==================================================
-- ENTITY SCHEDULER
--==================================================

local lastEntitySpawn = 0
local MIN_ENTITY_GAP = 25

local function runEntity(name, url, minTime, maxTime, roomDelay)
    task.spawn(function()
        while true do
            task.wait(math.random(minTime, maxTime))

            LatestRoom.Changed:Wait()
            task.wait(roomDelay or 1)

            local elapsed = os.clock() - lastEntitySpawn
            local remaining = MIN_ENTITY_GAP - elapsed

            if remaining > 0 then
                task.wait(remaining)
            end

            lastEntitySpawn = os.clock()

            local success, err = pcall(function()
                local source = game:HttpGet(url)
                local loadedScript = loadstring(source)

                assert(loadedScript, "Failed to compile " .. name)

                loadedScript()
            end)

            if not success then
                warn("[Archives+] " .. name .. " failed: " .. tostring(err))
            else
                print("[Archives+] " .. name .. " was triggered.")
            end
        end
    end)
end

