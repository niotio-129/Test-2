local function runA200()

    local success, err = pcall(function()

        local spawner = loadstring(
            game:HttpGet(A200SpawnerURL)
        )()

        local entity = spawner.Create({

            Entity = {
                Name = "A200",
                Asset = "https://github.com/Isth4t/DoorsModels/blob/main/200Moving.rbxm?raw=true",
                HeightOffset = 0
            },

            Lights = {
                Flicker = {
                    Enabled = true,
                    Duration = 1
                },

                Shatter = true,
                Repair = false
            },

            CameraShake = {
                Enabled = true,
                Range = 100,
                Values = {1.5, 20, 0.1, 1}
            },

            Movement = {
                Speed = 65,
                Delay = 2,
                Reversed = true
            },

            Rebounding = {
                Enabled = false,
                Type = "Ambush",
                Min = 1,
                Max = 1,
                Delay = 0.2
            },

            Damage = {
                Enabled = true,
                Range = 37,
                Amount = 100
            },

            Crucifixion = {
                Enabled = true,
                Range = 40,
                Resist = false,
                Break = true
            },

            Death = {
                Type = "Guiding",

                Hints = {
                    "You died to 200..",
                    "It's slow..",
                    "Hide when it comes..",
                    "Goodbye..",
                    "...",
                    "You can do it..."
                },

                Cause = "A200"
            }
        })

        entity:SetCallback("OnSpawned", function()
            print("[Archives+] A-200 has spawned!")
        end)

        entity:SetCallback("OnStartMoving", function()
            print("[Archives+] A-200 is moving.")
        end)

        entity:SetCallback("OnEnterRoom", function(room, firstTime)
            if firstTime then
                print("[Archives+] A-200 entered " .. room.Name)
            end
        end)

        entity:SetCallback("OnRebounding", function(startOfRebound)
            if startOfRebound then
                print("[Archives+] A-200 started rebounding.")
            else
                print("[Archives+] A-200 finished rebounding.")
            end
        end)

        entity:SetCallback("OnDespawning", function()
            print("[Archives+] A-200 is despawning.")
        end)

        entity:SetCallback("OnDespawned", function()
            print("[Archives+] A-200 has despawned.")

            task.wait(1)

            local achievementSuccess, achievementError = pcall(function()
                loadstring(game:HttpGet(A200AchievementURL))()
            end)

            if not achievementSuccess then
                warn("[Archives+] A-200 achievement failed: " .. tostring(achievementError))
            end
        end)

        entity:SetCallback("OnDamagePlayer", function(newHealth)
            if newHealth == 0 then
                print("[Archives+] A-200 killed the player.")
            else
                print("[Archives+] A-200 damaged the player.")
            end
        end)

        entity:Run()

    end)

    if not success then
        warn("[Archives+] A-200 failed: " .. tostring(err))
    end
end

