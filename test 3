--==================================================
-- ENTITY SCHEDULER
--==================================================

local function runEntity(name, url, minTime, maxTime, roomDelay)
    task.spawn(function()
        while true do
            task.wait(math.random(minTime, maxTime))

            LatestRoom.Changed:Wait()

            task.wait(roomDelay or 1)

            local success, err = pcall(function()
                local source = game:HttpGet(url)
                local loadedScript = loadstring(source)

                assert(loadedScript, "Failed to compile " .. name)

                loadedScript()
            end)

            if not success then
                warn("[Test Mode] " .. name .. " failed: " .. tostring(err))
            else
                print("[Test Mode] " .. name .. " was triggered.")
            end
        end
    end)
end

